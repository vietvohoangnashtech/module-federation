{
  "name": "mf-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:rsbuild": "concurrently --kill-others-on-fail 'pnpm:dev:lib' 'pnpm:dev:provider' 'wait-on http://localhost:3001/mf-manifest.json http://localhost:5000/mf-manifest.json && pnpm --filter mf_react_rsbuild dev'",
    "dev:vite": "concurrently --kill-others-on-fail 'pnpm:dev:lib' 'wait-on http://localhost:5000/mf-manifest.json && pnpm --filter mf_react_vite dev'",
    "storybook": "concurrently --kill-others-on-fail 'pnpm run dev:lib' 'wait-on http://localhost:5000/mf-manifest.json && pnpm --filter mf_lib storybook -p 6006'",
    "dev:webpack": "concurrently --kill-others-on-fail 'pnpm:dev:lib' 'wait-on http://localhost:5000/mf-manifest.json && pnpm --filter mf_react_webpack dev'",
    "dev:lib": "pnpm --filter mf_lib mf-dev",
    "dev:provider": "wait-on http://localhost:5000/mf-manifest.json && pnpm --filter mf_provider_app dev",
    "build:lib": "pnpm --filter mf_lib build",
    "build:provider": "pnpm --filter mf_provider_app build",
    "build:rsbuild": "pnpm --filter mf_react_rsbuild build",
    "build:vite": "pnpm --filter mf_react_vite build",
    "build:webpack": "pnpm --filter mf_react_webpack build",
    "test:webpack": "pnpm --filter mf_react_webpack test",
    "lint:webpack": "pnpm --filter mf_react_webpack lint",
    "typecheck:webpack": "pnpm --filter mf_react_webpack typecheck",
    "test:vite": "pnpm --filter mf_react_vite test",
    "lint:vite": "pnpm --filter mf_react_vite lint",
    "typecheck:vite": "pnpm --filter mf_react_vite typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
