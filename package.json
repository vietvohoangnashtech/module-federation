{
  "name": "mf-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:all": "concurrently --kill-others-on-fail 'pnpm:dev:shared' 'pnpm:dev:shell' 'pnpm:dev:products' 'pnpm:dev:cart' 'pnpm:dev:user' 'pnpm:dev:checkout'",
    "dev:shell": "pnpm --filter mf_shell dev",
    "dev:products": "pnpm --filter mf_products dev",
    "dev:cart": "pnpm --filter mf_cart dev",
    "dev:user": "pnpm --filter mf_user dev",
    "dev:checkout": "pnpm --filter mf_checkout dev",
    "dev:shared": "pnpm --filter mf_shared_lib dev",
    "build:all": "pnpm build:shared && pnpm build:shell && pnpm build:products && pnpm build:cart && pnpm build:user && pnpm build:checkout",
    "build:shell": "pnpm --filter mf_shell build",
    "build:products": "pnpm --filter mf_products build",
    "build:cart": "pnpm --filter mf_cart build",
    "build:user": "pnpm --filter mf_user build",
    "build:checkout": "pnpm --filter mf_checkout build",
    "build:shared": "pnpm --filter mf_shared_lib build",
    "test:all": "pnpm test:cart && pnpm test:checkout",
    "test:cart": "pnpm --filter mf_cart test",
    "test:checkout": "pnpm --filter mf_checkout test",
    "lint:all": "pnpm lint:cart && pnpm lint:checkout",
    "lint:cart": "pnpm --filter mf_cart lint",
    "lint:checkout": "pnpm --filter mf_checkout lint",
    "typecheck:all": "pnpm typecheck:cart && pnpm typecheck:checkout && pnpm typecheck:products && pnpm typecheck:shell && pnpm typecheck:user && pnpm typecheck:shared",
    "typecheck:cart": "pnpm --filter mf_cart typecheck",
    "typecheck:checkout": "pnpm --filter mf_checkout typecheck",
    "typecheck:products": "pnpm --filter mf_products typecheck",
    "typecheck:shell": "pnpm --filter mf_shell typecheck",
    "typecheck:user": "pnpm --filter mf_user typecheck",
    "typecheck:shared": "pnpm --filter mf_shared_lib typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
